# Controller-only settings for cfg-suite-controller.sh. Keep this file
# outside Git. Run parameters belong in cfg-suite.example.cfg.

# Directory containing this clone of zppy. The automation config separately
# names the root containing the repositories under test.
REPO_ROOT="$HOME/ez"

# Cfg-suite INI file; copy tests/cfg_suite/cfg-suite.example.cfg outside
# Git and edit it for this machine and account.
CFG_SUITE_CONFIG="$HOME/.config/zppy/cfg-suite.cfg"

# Held for the length of a run so a second firing exits instead of overlapping.
LOCK_FILE="$HOME/.zppy_cfg_suite.lock"

# Conda installation and the environment the controller itself runs in. This is
# not an environment under test; it only needs Python and zppy's dependencies.
CONDA_BASE="$HOME/miniforge3"
CONTROLLER_ENV="zppy_dev"  # needs mache and pytest; any zppy dev env works

# any | even | odd -- gate a weekly schedule down to biweekly.
WEEK_PARITY="any"

# Parent directory for controller logs; create it before installing the cron job.
LOG_DIR="$HOME/logs"
