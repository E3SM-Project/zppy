# Configuration for complete-run-controller.sh. Keep this file OUTSIDE Git:
# it names accounts and paths specific to one operator on one machine.

# chrysalis | compy | perlmutter
MACHINE="chrysalis"

# Directory holding the five repository clones (zppy, e3sm_diags, e3sm_to_cmip,
# MPAS-Analysis, zppy-interfaces).
REPO_ROOT="$HOME/ez"

# Group-writable root holding runs/ and baselines/. Leave empty for the
# machine's default web-served location; Compy has none and must set this.
SHARED_ROOT=""

# Held for the length of a run so a second firing exits instead of overlapping.
LOCK_FILE="$HOME/.zppy_complete_run.lock"

# Conda installation and the environment the controller itself runs in. This is
# not an environment under test; it only needs Python and zppy's dependencies.
CONDA_BASE="$HOME/miniforge3"
CONTROLLER_ENV="zppy_dev"  # needs mache and pytest; any zppy dev env works

# Sourced by generated task scripts before `conda activate`.
CONDA_PROFILE="$HOME/miniforge3/etc/profile.d/conda.sh"

SLURM_ACCOUNT="e3sm"

# any | even | odd -- gate a weekly schedule down to biweekly.
WEEK_PARITY="any"

# Anything else to pass to tests.complete_run.automation, e.g.
# EXTRA_AUTOMATION_ARGS="--cfg weekly_comprehensive_v3 --task e3sm_diags"
EXTRA_AUTOMATION_ARGS=""
